<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FC 27 Transfer Market"
        Height="550"
        Width="650"
        Background="#172033"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="25">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Rynek transferowy -->
        <StackPanel Grid.Column="0"
                    VerticalAlignment="Center">

            <TextBlock Text="FC 27 TRANSFERS"
                       FontSize="23"
                       FontWeight="Bold"
                       Foreground="#eafc27"
                       TextAlignment="Center"
                       Margin="0,0,0,15"/>

            <TextBlock x:Name="BudgetBlock"
                       Text="Budżet: 500 mln €"
                       FontSize="17"
                       Foreground="White"
                       TextAlignment="Center"
                       Margin="0,0,0,25"/>

            <ComboBox x:Name="PlayerBox"
                      FontSize="14"
                      Padding="8"
                      SelectedIndex="0"
                      Margin="0,0,0,15">

                <ComboBoxItem Content="Raphinha - 70 mln €" Tag="70"/>
                <ComboBoxItem Content="Bellingham - 160 mln €" Tag="160"/>
                <ComboBoxItem Content="Malen - 55 mln €" Tag="55"/>
                <ComboBoxItem Content="Yamal - 220 mln €" Tag="220"/>

            </ComboBox>

            <Button Content="KUP PIŁKARZA"
                    Click="BuyPlayer"
                    Background="#eafc27"
                    Foreground="#172033"
                    FontWeight="Bold"
                    FontSize="14"
                    Padding="12"
                    BorderThickness="0"/>

            <TextBlock x:Name="StatusBlock"
                       Text="Wybierz piłkarza!"
                       Foreground="White"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Margin="0,15,0,0"/>
        </StackPanel>

        <!-- Kupieni pilkarze -->
        <StackPanel Grid.Column="2"
                    VerticalAlignment="Center">

            <TextBlock Text="MOI PIŁKARZE"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="#eafc27"
                       TextAlignment="Center"
                       Margin="0,0,0,20"/>

            <ListBox x:Name="MyPlayersList"
                     Height="300"
                     Background="#25334B"
                     Foreground="White"
                     FontSize="15"
                     BorderThickness="0"
                     Padding="5"/>

            <TextBlock x:Name="PlayerCountBlock"
                       Text="Liczba piłkarzy: 0"
                       Foreground="White"
                       FontSize="15"
                       TextAlignment="Center"
                       Margin="0,15,0,0"/>
        </StackPanel>
    </Grid>
</Window>
