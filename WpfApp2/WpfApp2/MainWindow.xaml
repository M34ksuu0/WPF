<Window x:Class="Ankieta.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ankieta"
        Height="620" Width="1120"
        MinHeight="580" MinWidth="900"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.2*"/>
            <ColumnDefinition Width="0.2*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Wybór płci -->
        <GroupBox Grid.Row="0" Grid.Column="0"
                  BorderBrush="Black"
                  BorderThickness="3"
                  Padding="15">
            <StackPanel>
                <TextBlock Text="Wybierz płeć"
                           Margin="5,5,0,25"/>

                <RadioButton x:Name="rbMezczyzna"
                             Content="mężczyzna"
                             GroupName="Plec"
                             IsChecked="True"
                             Margin="0,0,0,3"/>

                <RadioButton x:Name="rbKobieta"
                             Content="kobieta"
                             GroupName="Plec"
                             Margin="0,0,0,3"/>

                <RadioButton x:Name="rbInne"
                             Content="inne"
                             GroupName="Plec"/>
            </StackPanel>
        </GroupBox>

        <!-- Formularz -->
        <GroupBox Grid.Row="2" Grid.Column="0"
                  BorderBrush="Black"
                  BorderThickness="3"
                  Padding="25">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="65"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="55"/>
                </Grid.RowDefinitions>

                <Label Content="wiek"
                       Grid.Row="0"
                       Grid.Column="0"/>

                <TextBox x:Name="txtWiek"
                         Grid.Row="0"
                         Grid.Column="1"
                         Width="100"
                         Height="27"
                         HorizontalAlignment="Left"
                         VerticalAlignment="Center"/>

                <Label Content="kolor"
                       Grid.Row="1"
                       Grid.Column="0"/>

                <ComboBox x:Name="cmbKolor"
                          Grid.Row="1"
                          Grid.Column="1"
                          Width="140"
                          Height="27"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Center">
                    <ComboBoxItem Content="czerwony"/>
                    <ComboBoxItem Content="zielony"/>
                    <ComboBoxItem Content="niebieski"/>
                    <ComboBoxItem Content="czarny"/>
                    <ComboBoxItem Content="biały"/>
                </ComboBox>

                <Label Content="zgoda"
                       Grid.Row="2"
                       Grid.Column="0"/>

                <CheckBox x:Name="chkZgoda"
                          Grid.Row="2"
                          Grid.Column="1"
                          VerticalAlignment="Center"
                          HorizontalAlignment="Left"/>

                <Button Content="zapisz"
                        Grid.Row="3"
                        Grid.Column="0"
                        Width="50"
                        Height="40"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Click="Zapisz_Click"/>
            </Grid>
        </GroupBox>

        <!-- Wyniki -->
        <GroupBox Grid.Row="0"
                  Grid.RowSpan="3"
                  Grid.Column="2"
                  BorderBrush="Black"
                  BorderThickness="3"
                  Padding="25">
            <StackPanel>
                <TextBlock Text="Wynik:"
                           FontSize="14"
                           Margin="0,0,0,15"/>

                <TextBlock x:Name="txtSredniWiek"
                           Text="-średnia wieku:"
                           Margin="0,0,0,20"/>

                <TextBlock x:Name="txtKolor"
                           Text="-najczęstszy kolor:"
                           Margin="0,0,0,20"/>

                <TextBlock x:Name="txtMezczyzni"
                           Text="-ile m"
                           Margin="0,0,0,20"/>

                <TextBlock x:Name="txtKobiety"
                           Text="-ile k"
                           Margin="0,0,0,20"/>

                <TextBlock x:Name="txtZgoda"
                           Text="-ile zgoda"/>
            </StackPanel>
        </GroupBox>

    </Grid>
</Window>
